# Copy to .env and fill in. .env is git-ignored; .env.example is committed.
# docker-compose reads .env automatically.

# --- Postgres (local docker-compose) --------------------------------------
# Throwaway local credentials — not a secret, but kept out of the committed
# compose file. The superuser is "postgres" (compose default).
POSTGRES_PASSWORD=judge
POSTGRES_DB=judge

# --- Backend (api + worker) ----------------------------------------------
# docker-compose sets DATABASE_URL / REDIS_URL / PGSSL on the containers
# itself (pointing at the service names), so they do not need to be here.
# For a bare `npm run api` / `npm run worker` against a local Postgres/Redis,
# leave them unset and the code falls back to localhost:5432 / localhost:6379,
# or set them explicitly, e.g.:
#   DATABASE_URL=postgres://postgres:judge@localhost:5432/judge
#   REDIS_URL=redis://localhost:6379
#   PGSSL=disable   # "disable" for a non-SSL server; unset for managed SSL

# REQUIRED. No fallback anywhere — the API refuses to start without it, so a
# known default can never leak to production and let tokens be forged.
# Generate one: openssl rand -hex 32
JWT_SECRET=

# API only.
PORT=3000
# When "true", submissions are stored and streamed but never executed (public
# demo). Unset / anything else = real sandbox execution.
DEMO_MODE=

# Worker only. Number of concurrent grading consumers, and — separately — of
# consumers for public-API executions (their own queue, their own capacity).
WORKER_CONCURRENCY=3
EXECUTION_WORKER_CONCURRENCY=2

# --- API hardening (all optional; strict defaults if unset) --------------
# Rate limits. Defaults: signup 3/hr/IP, login 5/15min/IP, submissions
# 20/min/user. Raise these only for load testing (see loadtest/README.md).
#   SIGNUP_RATE_MAX=3
#   SIGNUP_RATE_WINDOW_MS=3600000
#   LOGIN_RATE_MAX=5
#   LOGIN_RATE_WINDOW_MS=900000
#   SUBMISSION_RATE_MAX=20
#   SUBMISSION_RATE_WINDOW_MS=60000
# Number of reverse proxies in front of the API, so the real client IP is
# read from X-Forwarded-For for rate limiting. Unset = trust nothing (correct
# for the direct-connection docker-compose stack). Set to 1 behind one proxy.
#   TRUST_PROXY=1
# Request body / source-code size caps.
#   JSON_BODY_LIMIT=256kb
#   MAX_SOURCE_CODE_BYTES=65536

# --- Public execution API (/api/v1; all optional) -------------------------
# Active API keys per account. Usage is metered per account, not per key.
#   MAX_ACTIVE_API_KEYS=5
# Upper bounds a request may ask for (omitted = the bound). Out-of-range is
# a 400, never a silent clamp. Lower bounds are fixed: 100 ms / 32 MB.
#   EXECUTION_MAX_TIME_MS=5000
#   EXECUTION_MAX_MEMORY_MB=256
#   MAX_STDIN_BYTES=65536
# Usage controls, all per account (shared by its keys):
#   API_RATE_LIMIT_MAX=120            # requests per window (sliding)
#   API_RATE_LIMIT_WINDOW_MS=60000
#   API_DAILY_EXECUTION_QUOTA=1000    # executions per UTC day
#   API_MAX_CONCURRENT_EXECUTIONS=3   # executions queued or running at once
#   API_INFLIGHT_TTL_MS=600000        # how long a slot a crashed worker never freed can linger

# --- Frontend (build-time) ---------------------------------------------
# Where the browser reaches the API. For local docker-compose this is the
# host-published API port.
VITE_API_URL=http://localhost:3000
